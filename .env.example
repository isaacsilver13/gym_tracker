# Local development defaults to a SQLite file in the repo root.
# Production uses a Postgres URL, e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./gym_tracker_dev.db

# "development" enables permissive CORS for the Vite dev server and allows
# non-HTTPS session cookies. Any other value tightens both.
APP_ENV=development

# Signs session cookies. Set to a real random value in production.
SESSION_SECRET=dev-only-insecure-secret
